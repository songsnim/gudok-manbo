# Obsidian Vault 절대 경로 (예: C:\Users\User\Documents\MyVault)
VAULT_PATH=C:\Users\User\Documents\ObsidianVault

# OpenRouter (무료 tier)
OPENROUTER_API_KEY=sk-or-...
# 앞에서부터 시도, 429/빈응답이면 다음 모델로 폴백
OPENROUTER_MODELS=z-ai/glm-5.2:free,nvidia/nemotron-3-super-120b-a12b:free

# 요약 언어 (ko 또는 en)
SUMMARY_LANGUAGE=ko

# 하루 수집 할당량
DAILY_QUOTA=10
